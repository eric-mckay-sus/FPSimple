@typeparam T where T : class

<UniversalTable
    Items="Base.DataView"
    IsLoading="Base.IsLoading"
    EmptyMessage="@Base.EmptyMessage"
    CurrentPage="Base.CurrentPage"
    TotalPages="Base.TotalPages"
    TotalCount="Base.TotalCount"
    PageSize="Base.PageSize"
    OnPageChange="Base.ChangePage"
    ModelFilter="Base.ModelFilter"
    LineFilter="Base.LineFilter"
    OnFilterChange="() => Base.RefreshData()"
    ClearFilters="Base.ClearAllFilters"
    OnSort="Base.ToggleSort"
    GetSortIcon="Base.GetSortIcon"
    OnPageSizeChange="Base.AlterPageSize"
    OnPrint="OnPrint"
    PrintModeEngaged="PrintModeEngaged"
    SelectedForPrint="SelectedForPrint"
    SelectedForPrintChanged="SelectedForPrintChanged"
    OnExpand="OnExpand"
    OnApprove="OnApprove"
    OnDeny="OnDeny"
    OnRemake="OnRemake"
    Target="Target"
    TargetStyle="@TargetStyle"/>

@code{
    [Parameter, EditorRequired]
    public TableManager<T> Base { get; set; } = default!;

    [Parameter] public bool PrintModeEngaged { get; set; }
    [Parameter] public List<T?> SelectedForPrint { get; set; } = [];
    [Parameter] public EventCallback<List<T>> SelectedForPrintChanged { get; set; }
    [Parameter] public EventCallback<T> OnPrint { get; set; }
    [Parameter] public EventCallback<T> OnExpand { get; set; }
    [Parameter] public EventCallback<T> OnApprove { get; set; }
    [Parameter] public EventCallback<T> OnDeny { get; set; }
    [Parameter] public EventCallback<T> OnRemake { get; set; }
    [Parameter] public T? Target { get; set; }
    [Parameter] public string? TargetStyle { get; set; }
}
