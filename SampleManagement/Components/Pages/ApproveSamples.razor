@page "/approve-samples"
@attribute [Authorize(Roles = "Admin")]
@inherits TableManager<Sample>

<PageTitle>Approve Samples</PageTitle>

<h2 class="mb-2">Sample Approval</h2>

@* Approval panel - appears when a row's approve button is clicked *@
<div class="centered-container">
    <div class="expandable-container w-75">
        <div class="expandable-wrapper @(pendingSample != null ? "is-expanded" : "")">
            <div class="expandable-content">
                <div class="form-card animate-fade-in" style="min-height: 319px">
                    <h5 class="form-title mb-2">Approve Sample</h5>
                    <p class="text-muted">
                        @pendingSample?.Model / @pendingSample?.Line —
                        Sample #<strong>@pendingSample?.DummySampleNum</strong>:<br/>@pendingSample?.FailureMode
                    </p>
                    <div class="row align-items-end">
                        <div class="col-md-4 mb-1">
                            <label class="form-label">Expiration Date</label>
                            <input type="date"
                                class="form-control"
                                @bind="expiryDate"
                                min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(approvalError))
                    {
                        <div class="alert alert-danger py-2">@approvalError</div>
                    }
                    <div class="form-actions">
                        <button class="btn btn-outline-secondary me-2"
                                disabled="@isApproving"
                                @onclick="CancelApproval">Cancel</button>
                        <button class="btn btn-primary"
                                disabled="@(isApproving || expiryDate == default)"
                                @onclick="ConfirmApproval">
                            @if (isApproving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            <Icon Name="IconName.Check2" /> Confirm Approval
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Don't do anything in this file for expand (it's handled in UniversalTable), but provide a binding to show the button *@
<TablePresenter T="Sample"
                Base="this"
                Target="pendingSample"
                TargetStyle="table-success"
                OnExpand="() => {}"
                OnApprove="HandleApprove"
                OnDeny="HandleDeny" />

<DeleteDialog @ref="DeleteDialog" />
