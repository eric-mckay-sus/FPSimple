<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Only generates the XML doc when in debug mode -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Packages to include regardless of mode -->
  <ItemGroup>
    <PackageReference Include="Blazor.Bootstrap" Version="3.5.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.*" />
  </ItemGroup>

  <!-- Only use StyleCop when in debug mode -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- Setting private assets ensures this dependency is ignored in production -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="../stylecop.json" />
  </ItemGroup>

  <!-- Internal projects to reference -->
  <ItemGroup>
    <ProjectReference Include="..\UploadModelMappings\UploadModelMappings.csproj" />
    <ProjectReference Include="..\UploadFpInfo\UploadFpInfo.csproj" />
    <ProjectReference Include="..\PrintLabel\PrintLabel.csproj" />
  </ItemGroup>

</Project>
